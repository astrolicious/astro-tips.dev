{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.svg", "!**/examples/shadcn-ui/**/*"]
  },
  "formatter": {
    "lineWidth": 100
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "astro": "all",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAmbiguousAnchorText": "warn"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "useImageSize": "warn"
      },
      "nursery": {
        "noZeroLengthUnit": "warn",
        "useLogicalProperties": "warn"
      },
      "security": {
        "noSecrets": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useSelfClosingElements": "error"
      },
      "suspicious": {
        "noDeprecatedImports": "error",
        "noImportCycles": "error",
        "useBaseline": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [".github/scripts/mdx.js"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    }
  ]
}
