{
  "name": "astro-tips",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro sync && tsc --noEmit --runExternalCode && astro build",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome check --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.ts",
    "cf-typegen": "cf workers types",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/starlight": "0.43.1",
    "@fontsource/inter": "^5.3.0",
    "astro": "7.4.13",
    "satori-astro": "^0.4.1",
    "semver": "7.8.6",
    "sharp": "0.35.5",
    "starlight-package-managers": "0.13.1"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "cf": "1.0.0-rc.2",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.2.3",
    "typescript": "7.1.0-beta"
  }
