---
import { Aside } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ResourceExplorer from '~/components/ResourceExplorer.astro';
---

<StarlightPage
	frontmatter={{
		title: 'External resources',
		description:
			'Community-written Astro tutorials, recipes, guides, and deep dives from across the web.',
		tableOfContents: false,
	}}
>
	<p>
		See guided examples of adding features to your Astro project, submitted by our community
		members! <a href="https://docs.astro.build/en/recipes/">Astro recipes</a> are typically short,
		focused how-to guides that walk a reader through completing a working example of a specific
		task. Other guides explain concepts related to an area of content, such as using images or
		working with MDX.
	</p>

	<Aside type="tip" title="Add your own!">
		Have you written an Astro guide or recipe you would like to share? Read our{' '}
		<a href="/contributing">contributing guide</a> or add your link directly in{' '}
		<a
			href="https://github.com/astrolicious/astro-tips.dev/edit/main/src/content/resources.json"
			target="_blank"
			rel="noopener noreferrer"
		>
			<code>src/content/resources.json</code>
		</a>
		.
	</Aside>

	<ResourceExplorer />
</StarlightPage>
