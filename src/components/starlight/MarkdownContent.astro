---
import { Aside } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { minVersion, outside } from 'semver';
import AuthorList from '~/components/AuthorList.astro';
import CompatibilitySummary from '~/components/CompatibilitySummary.astro';
import CompatibilityTable from '~/components/CompatibilityTable.astro';
import { resolveAuthors } from '~/lib/authors';
import { getSemverUrl, hasCompatibilityInfo } from '~/lib/compatibility';
import pkg from '../../../package.json';

const { astroRange, authors: authorRefs, compatibility } = Astro.locals.starlightRoute.entry.data;
const authors = await resolveAuthors(authorRefs);
const astroVersion = minVersion(pkg.dependencies.astro)?.version;
// check if the Astro version is less than the required range.
const outRange = Boolean(astroRange && astroVersion && outside(astroVersion, astroRange, '>'));
const semverUrl = astroRange ? getSemverUrl('astro', astroRange) : undefined;
const showCompatibility = hasCompatibilityInfo(compatibility);
---

{
	// only show if the Astro version is less than the required range.
	outRange && astroRange && semverUrl && (
		<Aside type="caution">
			This guide was written for Astro <a href={semverUrl}>{astroRange}</a> and may not work for
			versions outside of that range.
			<br />
			We always try to keep our tips up to date, but if you see this caution, please open an{' '}
			<a href="https://github.com/astrolicious/astro-tips.dev/issues">issue</a> to let us know.
		</Aside>
	)
}

<Default>
	{
		showCompatibility && compatibility && (
			<CompatibilitySummary compatibility={compatibility} astroRange={astroRange} />
		)
	}
	<slot />
	{
		showCompatibility && compatibility && (
			<CompatibilityTable compatibility={compatibility} astroRange={astroRange} />
		)
	}
</Default>

{authors.length > 0 && <AuthorList authors={authors} />}
